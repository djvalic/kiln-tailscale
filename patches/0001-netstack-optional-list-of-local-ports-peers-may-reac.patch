 		connsInFlightByClient: make(map[netip.Addr]int),
 		packetsInFlight:       make(map[stack.TransportEndpointID]struct{}),
 		dns:                   dns,
+		kilnAllowedPorts:      parseKilnAllowedPorts(envknob.String(kilnAllowedPortsEnv)),
